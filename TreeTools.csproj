<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="'$(TreeToolsGameDataTool)' == 'true'" />
  <Import Project="Sdk.props" Sdk="Dalamud.CN.NET.Sdk" Version="15.0.0" Condition="'$(TreeToolsGameDataTool)' != 'true'" />

  <PropertyGroup>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tools\**</DefaultItemExcludes>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TreeToolsGameDataTool)' != 'true'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <DalamudApiLevel>15</DalamudApiLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TreeToolsGameDataTool)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup Condition="'$(TreeToolsGameDataTool)' != 'true'">
    <None Include="Tools\GameData\Program.cs" />
    <ProjectReference Include="..\OmenTools\OmenTools.csproj" />
    <ProjectReference Include="..\FFXIVClientStructs.Expansion\FFXIVClientStructs.Expansion\FFXIVClientStructs.Expansion.csproj" />
    <PackageReference Include="TinyPinyin" Version="1.1.0" />
    <PackageReference Include="DailyRoutines.CodeAnalysis" Version="2.6.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(TreeToolsGameDataTool)' == 'true'">
    <Compile Include="Tools\GameData\Program.cs" />
    <Compile Include="..\..\OmniToolbox.Common\Data\Runtime\*.cs" Link="GameData\%(Filename)%(Extension)" />
    <Compile Include="..\..\OmniToolbox.Common\Data\Loading\GameDataCSV.cs" Link="GameData\GameDataCSV.cs" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition="'$(TreeToolsGameDataTool)' == 'true'" />
  <Import Project="Sdk.targets" Sdk="Dalamud.CN.NET.Sdk" Version="15.0.0" Condition="'$(TreeToolsGameDataTool)' != 'true'" />
</Project>
